# Copy to .env.local and fill in. Never commit .env.local.

# --- app -------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000

# The deployment decides the storage mode. The browser and the agent cannot.
# Only the exact value "stored-key" selects the unsafe mode.
# Every other value resolves to "connected-app".
STORAGE_MODE=connected-app

# --- convex ----------------------------------------------------------------
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# --- kinde: the back-end web app that signs the user in ---------------------
KINDE_ISSUER_URL=https://your-subdomain.kinde.com
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000

# --- kinde: the M2M app that calls the Management API -----------------------
# The M2M application needs these Management API scopes:
#   read:connected_apps    fetch the auth url and the brokered token
#   create:connected_apps  revoke a connected app session
#   read:users             resolve the acting user
#   read:user_sessions     list a user's sessions
#   delete:user_sessions   invalidate a user's sessions
KINDE_M2M_CLIENT_ID=
KINDE_M2M_CLIENT_SECRET=
KINDE_MANAGEMENT_AUDIENCE=https://your-subdomain.kinde.com/api
# The "key code reference" of the GitHub connected app, set in Kinde under
# Settings > Connected apps. Configuration, not a secret.
#
# Grant that connected app exactly one GitHub scope: public_repo. The demo
# needs no identity scope — the acting GitHub login is read out of the API
# response, not granted as a permission.
KINDE_GITHUB_CONNECTED_APP_KEY=

# --- openai ----------------------------------------------------------------
OPENAI_API_KEY=
# The model id is configuration, never a literal in the source.
OPENAI_MODEL=

# --- github ----------------------------------------------------------------
# The repository the demo acts on.
GITHUB_TARGET_OWNER=
GITHUB_TARGET_REPO=

# Only used when STORAGE_MODE=stored-key. This is the token the unsafe mode
# holds on the app's behalf. Leave it empty in connected-app mode.
GITHUB_STORED_TOKEN=
